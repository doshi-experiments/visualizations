{
  // Cloudflare Worker serving only static assets — no server code.
  // There is no build step; `public/` is uploaded as-is.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "visualizations",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  }
}
